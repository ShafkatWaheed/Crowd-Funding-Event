# Copy to .env and fill in values

# Database (PostgreSQL, async driver)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/event_db

# Firebase (for ID token verification)
FIREBASE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json

# CORS: comma-separated origins (e.g. * or http://localhost:3000,https://app.example.com)
CORS_ORIGINS=*

# Optional: echo SQL
# DATABASE_ECHO=true
