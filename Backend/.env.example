# Copy to .env and fill in values. Do not commit .env.

# Project
# PROJECT_NAME=Crowd-Funded Event API
# API_V1_STR=/api/v1

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/event_db
# DATABASE_ECHO=false
# Use a separate DB for tests so pytest never truncates real data (e.g. event_db_test)
# TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/event_db_test

# Firebase (ID token verification)
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Email (optional)
# EMAIL_ENABLED=false
# EMAIL_PROVIDER=sendgrid
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@crowdfundevent.com
# EMAIL_FROM_NAME=CrowdFund Event

# Redis (ARQ task queue)
REDIS_URL=redis://localhost:6379/0

# Ticket QR encryption (64-char hex = 32 bytes). Leave empty for dev plaintext fallback.
TICKET_ENCRYPTION_KEY=
