# Copy to .env and fill in values

# Database (PostgreSQL, async driver)
DATABASE_URL=postgresql+asyncpg://postgres:mysecretpassword@localhost:5432/event_db

# Firebase (for ID token verification)
FIREBASE_PROJECT_ID=crowd-funding-event

# Path to Firebase service account JSON (use /mnt/c/... for WSL, C:\... for Windows)
GOOGLE_APPLICATION_CREDENTIALS=/mnt/c/Users/16136/Desktop/Crowd_Funding_Event/cred/crowd-funding-event.json

# CORS: comma-separated origins (e.g. * or http://localhost:3000,https://app.example.com)
CORS_ORIGINS=*

# Redis (ARQ task queue — background emails + refund processing)
REDIS_URL=redis://localhost:6379/0

# Optional: echo SQL
# DATABASE_ECHO=true
